{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "tests/support/**/*.ts",
    "js/**/*.test.ts",
    "tools/**/*.test.ts",
    "sw.test.ts"
  ],
  "exclude": []
}
