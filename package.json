{
  "name": "phosphor-loop",
  "private": true,
  "type": "module",
  "scripts": {
    "test:minimal": "node tests/minimal.mjs",
    "capture": "node tools/capture/run.mjs",
    "stream": "node tools/capture/run.mjs --live --headed",
    "stream:push": "node tools/capture/relay.mjs",
    "stream:test": "node tests/stream.mjs",
    "stream:rtmp-test": "node tests/rtmp.mjs",
    "capture:test": "node --test tests/capture.test.mjs",
    "capture:smoke": "node tests/capture-smoke.mjs",
    "capture:audio-test": "node tests/capture-audio.mjs",
    "loopback:test": "node tests/loopback.mjs",
    "audio:list": "swift -module-cache-path /tmp/phosphor-swift-cache tools/audio-route.swift list",
    "audio:test": "node tests/audio-route.mjs",
    "audio:activate": "swift -module-cache-path /tmp/phosphor-swift-cache tools/audio-route.swift activate",
    "audio:repair": "swift -module-cache-path /tmp/phosphor-swift-cache tools/audio-route.swift repair",
    "audio:setup": "swift -module-cache-path /tmp/phosphor-swift-cache tools/audio-route.swift setup",
    "audio:restore": "swift -module-cache-path /tmp/phosphor-swift-cache tools/audio-route.swift restore",
    "test:rhythm": "node tests/rhythm.mjs",
    "test:mappings": "node --experimental-strip-types --test js/audio/mappings.test.ts",
    "test:music-response": "node tests/music-response.mjs",
    "test:scene-recovery": "node tests/reference-recovery.mjs",
    "perf": "node tools/perf/benchmark.mjs",
    "test:render-quality": "node tests/render-quality.mjs",
    "test:visual-defaults": "node --experimental-strip-types --test js/app.defaults.test.ts",
    "test:lfo": "node --experimental-strip-types --test src/lfo-engine.test.ts src/lfo-state.test.ts",
    "test:onset-clock": "node --experimental-strip-types --test src/audio/beat-clock.test.ts js/audio/rhythm.test.ts",
    "test:control-dependencies": "node --experimental-strip-types --test src/control-dependencies.test.ts",
    "test:video-grade": "node --experimental-strip-types --test src/video-grade.test.ts",
    "test:shaders": "node tests/shader-equivalence.mjs",
    "test:control-automation": "node --experimental-strip-types --test js/app.automation.test.ts",
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{js,src,tests,tools}/**/*.{js,mjs,ts}\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"{js,src,tests,tools}/**/*.{js,mjs,ts}\" \"*.{js,json,ts}\"",
    "test:unit": "node --experimental-strip-types --test src/*.test.ts src/audio/*.test.ts tools/deploy/*.test.ts sw.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build:check",
    "test:control-routing": "node --experimental-strip-types --test src/control-routing.test.ts",
    "test:lfo-state": "node --experimental-strip-types --test src/lfo-state.test.ts",
    "test:legacy": "node --experimental-strip-types --test js/audio/mappings.test.ts js/app.defaults.test.ts",
    "test:integration": "node --experimental-strip-types --test js/app.automation.test.ts js/audio/rhythm.test.ts",
    "test": "npm run test:unit && npm run test:legacy && npm run test:integration",
    "test:browser": "npm run test:minimal",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "essentia.js": "0.1.3",
    "hls.js": "^1.7.3",
    "mp4-muxer": "^5.2.2",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.21",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "prettier": "2.8.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
